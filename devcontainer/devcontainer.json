{
  "name": "Self-Building AI",
  "context": "..",  // Set the context to the parent directory
  "dockerFile": "Dockerfile",  // Path to the Dockerfile
  "postCreateCommand": "pip install -r requirements.txt",  // Install dependencies after container creation
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"  // Mount the local workspace folder to /workspace inside the container
  ],
  "settings": {
    "python.pythonPath": "/usr/local/bin/python",  // Set the Python path for VS Code
    "python.autoComplete.extraPaths": [
      "/workspace"  // Ensure autocomplete works inside the workspace
    ]
  },
  "extensions": [
    "ms-python.python",  // Install Python extension for VS Code
    "ms-vscode.cpptools",  // Install C++ tools extension (if needed)
    "esbenp.prettier-vscode",  // Prettier for code formatting
    "dbaeumer.vscode-eslint",  // ESLint for JavaScript/TypeScript linting
    "ms-azuretools.vscode-docker"  // Docker extension for VS Code (optional, but useful)
  ],
  "remoteUser": "root",  // Use root as the default user for the container
  "ports": {
    "8000": {
      "label": "FastAPI App"  // Label for FastAPI port
    },
    "8501": {
      "label": "Streamlit UI"  // Label for Streamlit UI port
    }
  }
}
