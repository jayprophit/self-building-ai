{
  "name": "My Dev Container",
  "dockerComposeFile": [
    "./.devcontainer/docker-compose.yml"
  ],
  "service": "my_project",
  "workspaceFolder": "/app",
  "extensions": [
    "ms-python.python",
    "ms-vscode.cpptools",
    "ms-vscode-remote.vscode-remote-extensionpack"
  ],
  "settings": {
    "python.pythonPath": "/usr/local/bin/python"
  }
}
